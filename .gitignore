# Secrets — SECRET class, never committed. See docs/design/09-security.md
.env
.env.*
!.env.example

# Private data — USER/ is a symlink into the private repo.
# The symlink itself is ignored; a REGULAR file here fails CI.
USER/

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Installer backups — written by `iai install --apply`
*.iai-backup-*

# Python bytecode — scripts/ is Python
__pycache__/
*.py[cod]

# Test / coverage
coverage/
.nyc_output/

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# opencode session state. `.opencode/opencode.json` is checked in as project
# config; the runtime scratch files beside it are not.
.opencode/todo.json

# Session handoff notes. Agent scratch, rewritten every session and never a
# source of truth — issues, the ISA and docs/evidence/ are. Keep it local so a
# stale copy can never be mistaken for the record.
.opencode/HANDOFF.md
